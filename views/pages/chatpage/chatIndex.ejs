            // console.log('messagesBoxR : ', messagesBoxR);
            messageToAdd.innerHTML = `
                <p>${content}</p> <br>    
                <i>~${username}</i>
                `
            messageToAdd.classList += 'messageDiv';
            messageToAdd.id = id;



            // Add border radiuses depending on who sent the message
            if (id == userId) {
                // messageToAdd.style.backgroundColor = 'green'; // Doesn't actually look too bad
                messageToAdd.style.border = '2px solid purple'; // Doesn't actually look too bad
                messageToAdd.style.borderBottomRightRadius = '0px';
            } else if (id != userId) {
                // messageToAdd.style.backgroundColor = 'purple'; // Doesn't actually look too bad
                messageToAdd.style.borderBottomLeftRadius = '0px';
            } else {
                console.log("su'in else went terrribly wrong")
            }

            // console.log(messageToAdd)
            if (topOrBottom == 'top') {
                messagesBoxR.insertBefore(messageToAdd, messagesBoxR.firstChild) // doing it this way allows us to add the child to the beginning of the div, so the messages can appear in the correct chronological order
            } else if (topOrBottom == 'bottom') {
                messagesBoxR.appendChild(messageToAdd)
            } else {
                return "error: you didn't give either top or bottom for the 'topOrBottom' variable"
            }

            scrollElToBottom(messagesBoxR);

        }

