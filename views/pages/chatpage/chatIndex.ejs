        const addMessage = async (data, userId, topOrBottom) => {
            // console.log('addMessage FUNC called');

            const {content, username, id} = data;
            // console.log('content : ', content);
            // console.log('username : ', username);
            // console.log('id : ', id);

            messagesBoxR = document.querySelector('#messagesBox');
