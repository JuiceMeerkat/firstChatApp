<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>bakugo - profile</title>
    <link rel="stylesheet" href="/css/main.css"> 
    <link rel="stylesheet" href="/css/profilePage.css">
</head>
<body>
    <header><% if (user) { %>
            <%- include('../../partials/header-logged-in.ejs'); %>
          <% } else if (!user) { %>
            <%- include('../../partials/header-not-logged-in.ejs'); %>
          <% } else { %>
            <%- console.log("su'in else") %>
          <% } %>
    </header>

    <div id="notificationsList"></div>


    <h1>This is the profile page</h1>
    <h2>Here is information about your account that is public</p>

    <main>
        <!-- <h2> Coming soon.... <br> We are sorry for the delay but this page is not yet ready. </h2> -->

        <p>Your name is: <%= user.username %></p>
        <p>Your email is: <%= user.email %></p>
        <p>Your role is: <%= user.role %></p>
        

    </main>

    <script src="/js/notifications.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/socketStuff.js"></script>
</body>
</html>