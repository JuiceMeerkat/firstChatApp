<body>
    <header><% if (user) { %>
            <%- include('../../partials/header-logged-in.ejs'); %>
          <% } else if (!user) { %>
            <%- include('../../partials/header-not-logged-in.ejs'); %>
          <% } else { %>
            <%- console.log("su'in else") %>
          <% } %>
    </header>

    <div id="notificationsList"></div>

    <h1>This is the my actions page</h1>
    

    <main>
            <!-- <h2>Coming soon...</h2>
            <h3>Unfortunately, this page is still in progress. Sorry!</h3> -->

            <p id="explanationP">
                On this page, you will see the actions that all different roles can achieve. <br>
                Don't try to hack your way into doing something you can't - you'll only be wasting your time! <br>
                Try to gain devs trust and friendship and they might upgrade your role! <br>
